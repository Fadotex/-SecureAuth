{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/v1/server.js",
  "scripts": {
    "start": "node dist/v1/server.js",
    "dev": "tsx watch src/v1/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:constraints": "tsx scripts/apply-active-booking-constraints.ts",
    "db:seed": "tsx prisma/seed.ts",
    "provision:first-admin": "tsx scripts/provision-first-administrator.ts",
    "provision:demo": "tsx scripts/provision-demo-accounts.ts",
    "demo:reset-passwords": "tsx scripts/reset-demo-account-passwords.ts",
    "demo:show-passwords": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/show-demo-credentials.ps1",
    "test": "vitest run --exclude dist/**",
    "test:watch": "vitest",
    "migrate:supabase": "node scripts/migrate-sqlite-to-supabase.js",
    "reset:admin-password": "node scripts/reset-admin-password.js",
    "backup:supabase": "node scripts/backup-supabase-users.js",
    "backup:restore": "node scripts/restore-supabase-users.js",
    "backup:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-backup-task.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.10",
    "otplib": "^13.5.0",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
