NODE_ENV=development
HOSTEL_API_HOST=127.0.0.1
HOSTEL_API_PORT=3001
DATABASE_URL=postgresql://secureauth_app:<private-password>@localhost:5432/secureauth?schema=secureauth_app
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
PEPPER=replace-with-a-separate-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-from-32-random-bytes
FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:5174
HOLD_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_IPS=
PAYSTACK_CALLBACK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
